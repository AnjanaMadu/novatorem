# Now Playing Widget - Environment Variables
# Copy this file to .env and fill in your values
# You only need to configure ONE service (YouTube, Spotify, or Last.fm)

# ===================
# YOUTUBE (Option 1)
# ===================
# Uses the official YouTube Data API to show the newest liked video
# categorized as Music. See SetUp.md for OAuth setup instructions.

YOUTUBE_CLIENT_ID=your_google_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_google_oauth_refresh_token_here

# Neon/PostgreSQL cache (recommended for serverless deployments)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
YOUTUBE_CACHE_TTL_SECONDS=60

# ===================
# SPOTIFY (Option 2)
# ===================
# Get these from https://developer.spotify.com/dashboard/applications
# See SetUp.md for detailed instructions on obtaining the refresh token

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_SECRET_ID=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# ===================
# LAST.FM (Option 3)
# ===================
# Get your API key from https://www.last.fm/api/account/create
# Your username is visible in your Last.fm profile URL

LAST_FM_API_KEY=your_lastfm_api_key_here
LAST_FM_USERNAME=your_lastfm_username_here
